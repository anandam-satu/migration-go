# Copy this file to `.env` and adjust the values, then run the worker from the
# same directory (or point ENV_FILE at the file, e.g. ENV_FILE=C:\cfg\my.env).
#
#   cp .env.example .env
#   go run ./cmd/server
#
# Precedence: real environment variables set in the shell/launcher WIN over
# `.env`. Variables omitted here fall back to the defaults baked into
# internal/config (see the README table). Keep `.env` out of git — it is
# gitignored.

# ================================
# LEGACY MYSQL SOURCE (MyBiz)
# ================================
APP_MYSQL_ENABLED=true
DB_MYSQL_HOST=192.168.1.246
DB_MYSQL_PORT=3307
DB_MYSQL_NAME=anandamid26
DB_MYSQL_USER=root
# Leave empty for the default (no password):
DB_MYSQL_PASSWORD=

# ================================
# POSTGRESQL SINK (stok-anandam)
# ================================
DB_PG_HOST=192.168.1.176
DB_PG_PORT=5432
DB_PG_NAME=stok-anandam
DB_PG_USER=anandamstok
DB_PG_PASSWORD=Letmein99+

# ================================
# SERVER / MISC
# ================================
MIGRATION_LEGACY_SCHEMA=anandamid26
SERVER_PORT=9089

# ================================
# GOOGLE SHEETS PRICELIST SYNC
# ================================
# Path to the service-account JSON shared with the pricelist spreadsheet.
# Leave empty to disable the pricelist sync. Use forward slashes on Windows
# (C:/secrets/service_account.json) or keep backslashes — unquoted values are
# taken literally:
GOOGLE_SERVICE_ACCOUNT_FILE=C:/secrets/service_account.json

# Optional overrides (defaults shown). PRICELIST_SHEET_RANGE is normally left
# unset — the built-in default is the tab 'PRICELIST&MODAL' columns A:D. If you
# really need to change it, double-quote the whole value (the single quotes
# around the tab name are part of the value, and an unquoted line like
# PRICELIST_SHEET_RANGE='PRICELIST&MODAL'!A:D would be a parse error):
# PRICELIST_SHEET_RANGE="'PRICELIST&MODAL'!A:D"
PRICELIST_SPREADSHEET_ID=173w5Y8hynv8lOphrsjtCx0tc8CJIQThuLrMIttwtw30
PRICELIST_SYNC_INTERVAL=1m
